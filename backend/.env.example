# Backend API / SQL Server
API_PORT=4000
# En produccion es obligatorio definir una clave secreta de al menos 32 caracteres:
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria-de-32-caracteres-minimo
TOKEN_TTL_HOURS=12

# Opcion A: SQL Server publico con SQL Server Authentication.
DB_SERVER=tu-servidor.database.windows.net,1433
DB_DATABASE=tu_base_de_datos
DB_USER=tu_usuario
DB_PASSWORD=tu_password
DB_TRUSTED_CONNECTION=false

# Opcion B: SQL Server local con Windows Authentication.
# DB_SERVER=DESKTOP-IOIVV78
# DB_INSTANCE=HOTEL_2026
# DB_DATABASE=HotelDB
# DB_TRUSTED_CONNECTION=true

# Driver: msnodesqlv8 (Windows/ODBC) o tedious (Linux/hosting con DB_USER y DB_PASSWORD).
# DB_CLIENT=msnodesqlv8
DB_DRIVER=SQL Server
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_CONNECTION_TIMEOUT=10000
DB_REQUEST_TIMEOUT=15000

# Opcional: origenes CORS separados por coma si el frontend se sirve desde otro dominio.
# CORS_ORIGIN=https://tu-frontend.vercel.app
